# LaunchPilot — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# Every variable is validated at boot by lib/env.ts (Zod). Missing/invalid = boot fails loud.

# ── Core ────────────────────────────────────────────────────────────────────
# Public base URL of the app. Used for auth callbacks and absolute links.
# Default (local): http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Pooled connection string (app runtime). From Neon or Supabase dashboard.
DATABASE_URL=
# Direct (non-pooled) connection string. Used by Drizzle migrations only.
DATABASE_URL_UNPOOLED=

# ── Auth (better-auth) ───────────────────────────────────────────────────────
# Random 32+ char secret. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Google OAuth — from Google Cloud Console → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (Anthropic Claude) ────────────────────────────────────────────────────
# From console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Model ids (override only with intent). Craft = chat; Fast = classification.
ANTHROPIC_MODEL_CRAFT=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ── Text-to-Speech (Google Cloud) ────────────────────────────────────────────
# Preferred: a Google API key restricted to the Cloud Text-to-Speech API
# (works when org policy blocks service-account key creation). Called via REST.
GOOGLE_TTS_API_KEY=
# Alternative: path to a service-account JSON key (if your org allows SA keys).
GOOGLE_APPLICATION_CREDENTIALS=

# ── Product analytics + flags (PostHog) ──────────────────────────────────────
# NEXT_PUBLIC_* are client-exposed by design (publishable keys), not secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error tracking (Sentry) ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# SECRET — used only at build time to upload source maps. Keep out of the repo.
SENTRY_AUTH_TOKEN=

# ── Magic-link email (Resend) ────────────────────────────────────────────────
# Unset: dev mailbox in development (/api/dev/magic-link), loud log-only in
# production. To deliver magic links in production, create a Resend account
# (https://resend.com), verify a sending domain, then set:
# EMAIL_PROVIDER=resend
EMAIL_PROVIDER=
RESEND_API_KEY=
# Verified sender, e.g. "LaunchPilot <login@yourdomain.com>"
EMAIL_FROM=

# --- SMS OTP delivery (Slice C) --------------------------------------------
# Unset: dev mailbox in development (/api/dev/otp), loud log-only in
# production. To go live worldwide incl. Bangladesh, create a free trial at
# https://www.twilio.com (~$15 credit), buy/verify a From number, then set:
# SMS_PROVIDER=twilio
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Cost guardrails ──────────────────────────────────────────────────────────
# Hard cap on AI spend per user per UTC day, in USD. System degrades gracefully past it.
AI_DAILY_USD_CAP_PER_USER=0.50
